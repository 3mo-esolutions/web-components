{
	"type": "module",
	"scripts": {
		"start": "npm run clean && npm install --loglevel=error && npm run analyze && storybook dev -p 3000",
		"dev": "vitest --project chromium",
		"test": "vitest run",
		"test:ssr": "node ./scripts/test-ssr.ts",
		"test:ssr:hydration": "node ./scripts/test-ssr-hydration.ts",
		"lint": "eslint \"**/*.ts\"",
		"docs:build": "node ./scripts/docs-build.ts",
		"clean": "node ./scripts/clean.ts",
		"typescript": "node ./node_modules/typescript-7/bin/tsc --build --noEmit && node ./node_modules/typescript-7/bin/tsc -p packages/tsconfig.json",
		"release": "node ./scripts/release.ts",
		"release:all": "node ./scripts/release-all.ts",
		"build": "npm run clean && node ./node_modules/typescript/bin/tsc --build && npm run clean",
		"analyze": "node ./scripts/analyze.ts",
		"readme": "node ./scripts/readme.ts",
		"pre-commit": "node ./scripts/pre-commit.ts"
	},
	"pre-commit": "pre-commit",
	"workspaces": [
		"./packages/*"
	],
	"devDependencies": {
		"@a11d/eslint-config": "x",
		"@a11d/lit": "x",
		"@custom-elements-manifest/analyzer": "x",
		"@lit-labs/ssr": "4.x",
		"@lit-labs/ssr-client": "1.x",
		"@storybook/addon-docs": "10.x",
		"@storybook/addon-links": "10.x",
		"@storybook/addon-themes": "10.x",
		"@storybook/builder-vite": "10.x",
		"@storybook/web-components-vite": "10.x",
		"@types/node": "26.x",
		"@typescript-eslint/eslint-plugin": "x",
		"@typescript-eslint/parser": "x",
		"@vitest/browser-playwright": "5.x",
		"@vueless/storybook-dark-mode": "9.x",
		"ajv": "8.x",
		"concurrently": "x",
		"del-cli": "x",
		"esbuild": "0.x",
		"eslint": "x",
		"eslint-plugin-import": "x",
		"eslint-plugin-lit": "x",
		"eslint-plugin-storybook": "10.x",
		"execa": "x",
		"history": "x",
		"playwright": "1.x",
		"pre-commit": "x",
		"react-router": "x",
		"storybook": "10.x",
		"typescript": "6.x",
		"typescript-7": "npm:typescript@7.x",
		"vite": "6.x",
		"vitest": "5.x",
		"web-component-analyzer": "2.x"
	},
	"dependencies": {
		"@faker-js/faker": "x"
	},
	"overrides": {
		"@lit-labs/ssr": {
			"@types/node": "$@types/node"
		}
	}
}
