{
	"name": "@3mo/chip",
	"version": "0.4.3",
	"description": "Web components for selectable, removable and linking chips, and chip sets that share one selection and one tab stop.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/Chip"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"chip",
		"tag",
		"filter"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/actions-chip--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@3mo/theme": "x",
		"@3mo/localization": "x",
		"@3mo/focus-ring": "x",
		"@3mo/icon": "x",
		"@3mo/slot-controller": "x",
		"@3mo/disabled-property": "x",
		"@3mo/selectability": "x",
		"@3mo/selection-group": "x",
		"@material/web": "1.x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
