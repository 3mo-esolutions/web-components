{
	"name": "@3mo/collapsible-card",
	"version": "0.2.3",
	"description": "A web component for cards whose body collapses and expands from a toggle in the header.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/CollapsibleCard"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"material",
		"card",
		"collapsible"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/layout-collapsible-card--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@3mo/card": ">=0.3.3",
		"@3mo/tooltip": "x",
		"@3mo/localization": "x",
		"@3mo/expand-collapse-icon-button": "x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
