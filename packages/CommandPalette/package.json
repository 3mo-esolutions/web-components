{
	"name": "@3mo/command-palette",
	"version": "0.2.4",
	"description": "A web component for a Ctrl+K command palette that searches registered data sources and runs the chosen command.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/CommandPalette"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"command",
		"command-palette"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/actions-command-palette--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x",
		"typescript-memoize": "1.x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@a11d/lit-application": "x",
		"@3mo/fetcher-controller": "0.2.x",
		"@3mo/flex": "x",
		"@3mo/scroller": "x",
		"@3mo/icon": "x",
		"@3mo/key": "x",
		"@3mo/field": "x",
		"@3mo/empty-state": "x",
		"@3mo/tab": "x",
		"@3mo/list": "x",
		"@3mo/card": "x",
		"@3mo/text-fields": "x",
		"@3mo/button": "x",
		"@3mo/localization": "x"
	}
}
