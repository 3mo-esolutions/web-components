{
	"name": "@3mo/copy-icon-button",
	"version": "0.1.2",
	"description": "A web component for icon buttons that copy a value to the clipboard and confirm it in place with a check mark.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/CopyIconButton"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"copy",
		"clipboard",
		"icon-button"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/actions-copy-icon-button--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@3mo/disabled-property": "x",
		"@3mo/icon": "x",
		"@3mo/icon-button": "x",
		"@3mo/localization": "x",
		"@3mo/swap": "x",
		"@3mo/theme": "x",
		"@3mo/tooltip": "x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
