{
	"name": "@3mo/data-grid",
	"version": "0.38.4",
	"description": "A web component for data grids with typed columns, sorting, selection, pagination, row details and inline editing.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/DataGrid"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"material",
		"data-grid"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/data-data-grids-data-grid--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./controller": {
			"source": "./controller/index.ts",
			"types": "./dist/controller/index.d.ts",
			"default": "./dist/controller/index.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x",
		"@a11d/equals": "x",
		"@a11d/key-path": "2.x",
		"requestidlecallback-polyfill": "x"
	},
	"peerDependencies": {
		"@a11d/lit": ">=0.13.0",
		"@3mo/pointer-controller": ">=1.6.0",
		"@a11d/lit-application": "x",
		"@3mo/flex": "x",
		"@3mo/grid": "x",
		"@3mo/scroller": ">=0.5.0",
		"@3mo/icon": "x",
		"@3mo/icon-button": "x",
		"@3mo/checkbox": "x",
		"@3mo/slot-controller": "x",
		"@3mo/instanceof-attribute-controller": "x",
		"@3mo/resize-observer": "x",
		"@3mo/reorderability": "x",
		"@3mo/selectability": ">=0.3.0",
		"@3mo/expandability": "x",
		"@3mo/hierarchy": "x",
		"@3mo/localization": "x",
		"@3mo/navigability": "x",
		"@3mo/popover": ">=0.11.0",
		"@3mo/menu": ">=0.11.0",
		"@3mo/context-menu": ">=0.7.0",
		"@3mo/tooltip": ">=0.11.0",
		"@3mo/anchor": "x",
		"@3mo/number-fields": "x",
		"@3mo/tab": "x",
		"@3mo/text-fields": "x",
		"@3mo/select-field": "x",
		"@3mo/section": "x",
		"@3mo/date-time-fields": "x",
		"@3mo/empty-state": "x",
		"@3mo/splitter": "x",
		"@3mo/theme": ">=0.4.x",
		"@3mo/downloader": "x",
		"@3mo/line": "x",
		"@3mo/heading": "x",
		"@3mo/circular-progress": "x"
	}
}
