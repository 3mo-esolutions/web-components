{
	"name": "@3mo/date-time",
	"version": "0.11.0",
	"description": "Utilities for dates and times on Temporal: global DateTime, DateTimeRange and TimeSpan classes that parse localized input.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/DateTime"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"date"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/utilities-date-time--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"temporal-polyfill": "0.2.x",
		"tslib": "x",
		"typescript-memoize": "1.x"
	},
	"peerDependencies": {
		"@3mo/localization": ">=0.10.0"
	}
}
