{
	"name": "@3mo/date-time-fields",
	"version": "0.17.2",
	"description": "Web components for date, date-time, time and range fields with locale-aware segmented entry and a calendar picker.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/DateTimeFields"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"date-time",
		"field-date",
		"field-time",
		"field-date-range"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/inputs-date-time-fields-date-field--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@a11d/equals": "x",
		"tslib": "x",
		"typescript-memoize": "1.x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@3mo/date-time": ">=0.10.x",
		"@3mo/field": ">=0.5.x",
		"@3mo/flex": "x",
		"@3mo/grid": "x",
		"@3mo/icon": "x",
		"@3mo/icon-button": "x",
		"@3mo/interval-controller": "x",
		"@3mo/focus-controller": "x",
		"@3mo/intersection-observer": "x",
		"@3mo/list": "x",
		"@3mo/localization": "x",
		"@3mo/popover": ">=0.9.x",
		"@3mo/scroller": ">=0.5.x",
		"@3mo/segmented-input": "x",
		"@3mo/tab": "x",
		"@3mo/text-fields": "x",
		"@3mo/line": "x",
		"@3mo/switch": "x"
	}
}
