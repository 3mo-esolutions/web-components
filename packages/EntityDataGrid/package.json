{
	"name": "@3mo/entity-data-grid",
	"version": "0.4.3",
	"description": "A web component for fetchable data grids that create, edit and delete entities through dialogs and a context menu.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/EntityDataGrid"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"material",
		"data-grid"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/data-data-grids-entity-data-grid--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@a11d/lit-application": "x",
		"@3mo/fab": "x",
		"@3mo/context-menu": "x",
		"@3mo/entity-dialog": ">=0.6.1",
		"@3mo/fetchable-data-grid": ">=0.6.1",
		"@3mo/fetchable-dialog": "x",
		"@3mo/tooltip": "x",
		"@3mo/loading-button": "x",
		"@3mo/icon": "x",
		"@3mo/data-grid": "x",
		"@3mo/localization": "x"
	}
}
