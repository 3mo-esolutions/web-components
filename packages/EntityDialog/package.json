{
	"name": "@3mo/entity-dialog",
	"version": "0.6.4",
	"description": "A web component for dialogs that fetch an entity to create or edit, then save it with Ctrl+S or delete it.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/EntityDialog"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"material",
		"dialog",
		"entity-dialog"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/data-entity-dialog--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x",
		"@a11d/metadata": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@a11d/lit-application": "x",
		"@3mo/fetchable-dialog": "x",
		"@3mo/fetcher-controller": "0.2.x",
		"@3mo/loading-button": "x",
		"@3mo/localization": "x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
