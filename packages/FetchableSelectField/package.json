{
	"name": "@3mo/fetchable-select-field",
	"version": "0.3.3",
	"description": "A web component for select fields that fetch their options and search on the server as the user types.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/FetchableSelectField"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-components",
		"material",
		"select",
		"select-field",
		"fetchable",
		"fetchable-select-field"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/inputs-fetchable-select-field--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x",
		"@a11d/equals": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@3mo/select-field": "x",
		"@3mo/fetcher-controller": "0.2.x",
		"@3mo/localization": "x"
	}
}
