{
	"name": "@3mo/select-field",
	"version": "0.11.2",
	"description": "Web components for select fields and their options, single or multiple, searchable or free-text, as an ARIA combobox.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/SelectField"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-components",
		"material",
		"select",
		"select-field"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/inputs-select-field--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@3mo/icon-button": "x",
		"@3mo/field": "x",
		"@3mo/theme": ">=0.5.4",
		"@3mo/popover": "x",
		"@3mo/list": "x",
		"@3mo/line": "x",
		"@3mo/selectability": "x",
		"@3mo/icon": "x",
		"@3mo/checkbox": "x",
		"@3mo/localization": "x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
