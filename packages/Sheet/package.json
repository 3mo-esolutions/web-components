{
	"name": "@3mo/sheet",
	"version": "0.1.4",
	"description": "A web component for modal sheets anchored to any screen edge with swipe-to-dismiss, built on the native dialog element.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/Sheet"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"sheet",
		"bottom-sheet",
		"side-sheet",
		"drawer",
		"dialog"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/layout-sheet--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x"
	},
	"peerDependencies": {
		"@a11d/lit": ">=0.13.0",
		"@3mo/theme": "x",
		"@3mo/localization": "x",
		"@3mo/swipeability": "x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
