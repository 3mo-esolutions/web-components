{
	"name": "@3mo/standard-dialogs",
	"version": "0.4.5",
	"description": "Web components for ready-made dialogs: alerts, confirmations, text prompts, deletion confirmations and generic ones.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/StandardDialogs"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"splitter"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/feedback-standard-dialogs-generic-dialog--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@a11d/local-storage": "x",
		"tslib": "x",
		"csstype": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@a11d/lit-application": "x",
		"@3mo/flex": "x",
		"@3mo/dialog": "x",
		"@3mo/localization": "x",
		"@3mo/text-fields": "x",
		"@3mo/loading-button": "x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
