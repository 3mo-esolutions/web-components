{
	"name": "@3mo/text-fields",
	"version": "0.1.3",
	"description": "Web components for text, email, search, password and multi-line fields, the password one with a reveal toggle.",
	"repository": {
		"type": "git",
		"url": "https://github.com/3mo-esolutions/web-components",
		"directory": "packages/TextFields"
	},
	"bugs": {
		"url": "https://github.com/3mo-esolutions/web-components/issues"
	},
	"keywords": [
		"lit",
		"web-component",
		"material",
		"input",
		"field",
		"textfield",
		"textarea",
		"mo-field-text",
		"mo-field-textarea",
		"mo-field-password",
		"mo-field-email"
	],
	"author": "3MO GmbH",
	"license": "MIT",
	"homepage": "https://3mo-esolutions.github.io/web-components/?path=/docs/inputs-text-fields-text-field--overview",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./translations/*": {
			"source": "./translations/*.ts",
			"types": "./dist/translations/*.d.ts",
			"default": "./dist/translations/*.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"customElements": "dist/custom-elements.json",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"tslib": "x"
	},
	"peerDependencies": {
		"@a11d/lit": "x",
		"@3mo/icon": "x",
		"@3mo/icon-button": "x",
		"@3mo/field": ">=0.6.0",
		"@3mo/localization": "x"
	},
	"devDependencies": {
		"@a11d/lit-testing": "x"
	}
}
