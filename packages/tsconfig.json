{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"types": ["vitest/globals", "vite/client"],
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true
	},
	"include": [
		"**/*.test.ts",
		"**/*.stories.ts",
